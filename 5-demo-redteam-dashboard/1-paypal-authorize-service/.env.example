# mock = in-memory PayPal stand-in (default, no credentials needed)
# live = real PayPal REST API; use the sandbox base URL while developing
PAYPAL_MODE=mock
SERVICE_TOKEN=change-me-shared-with-gateway
CAPTURE_SECRET=change-me-shared-with-gateway
HOLD_TTL_SECONDS=900

# live mode only (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:8004/paypal/return
PAYPAL_CANCEL_URL=http://localhost:8004/paypal/cancel
